{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "outputStyle": "onovasdev",
    "attribution": {
        "commit": "",
        "pr": ""
    },
    "statusLine": {
        "type": "command",
        "command": "{{PROJECT_PATH}}/.claude/scripts/statusline.sh",
        "padding": 0
    },
    "env": {
        "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
    },
    "spinnerVerbs": {
        "mode": "replace",
        "verbs": [
            "A ver, a ver...",
            "Agardando que escampe",
            "Dándolle ao coco",
            "Pensando as cousas",
            "Mirando a chuvia",
            "Consultando coa almofada",
            "Depende do tempo",
            "Sen présa pero sen pausa",
            "Facendo a empanada mental",
            "Algo haberá",
            "Non sei, non sei",
            "Estou a rumiar",
            "Con calma, que non hai lume",
            "Botándolle un ollo",
            "Pensando as cousas con tempo",
            "Mañá vémonos",
            "Pode ser que si, pode ser que non",
            "Con morriña pero pensando",
            "Un momento, compañeiro",
            "Reflexionando en voz baixa",
            "Xa vou, xa vou",
            "Aquí está a cousa",
            "En proceso, tranquilo",
            "Compilando con orgullo",
            "Xa case, sen présa",
            "Debatendo co meu interior",
            "Ao seu ritmo",
            "Tecendo o resultado",
        ]
    },
    "permissions": {
        "deny": [
            "Read(.env)",
            "Read(.env.*)",
            "Read(.env.local)",
            "Read(.env.production)",
            "Read(.env.development)",
            "Read(**/.env)",
            "Read(**/.env.*)",
            "Read(**/secrets/**)",
            "Read(**/credentials.json)"
        ],
        "ask": [
            "Bash(git commit:*)",
            "Bash(git push:*)",
            "Bash(git push --force:*)",
            "Bash(git rebase:*)",
            "Bash(git reset --hard:*)"
        ],
        "allow": [
            "Read",
            "Glob",
            "Grep",
            "Bash(git status:*)",
            "Bash(git diff:*)",
            "Bash(git checkout:*)",
            "Bash(git branch:*)",
            "Bash(git log:*)",
            "Bash(git stash:*)",
            "Bash(git fetch:*)",
            "Bash(git pull:*)",
            "Bash(which:*)",
            "Bash(gh:*)",
            "Bash(cat:*)",
            "Bash(ls:*)",
            "Bash(touch:*)",
            "Bash(head:*)",
            "Bash(tail:*)",
            "Bash(wc:*)",
            "Bash(grep:*)",
            "Bash(find:*)",
            "Bash(curl:*)",
            "Bash(wget:*)",
            "Bash(echo:*)",
            "Bash(printf:*)",
            "Bash(pwd:*)",
            "Bash(cd:*)",
            "Bash(env:*)",
            "Bash(export:*)",
            "Bash(source:*)",
            "WebFetch",
            "WebSearch"
        ]
    }
}